# Ensure consistent line endings across platforms
# Shell scripts must have LF (Unix) line endings
*.sh text eol=lf

# PowerShell scripts should have CRLF (Windows) line endings
*.ps1 text eol=crlf

# Rust source files
*.rs text eol=lf
*.toml text eol=lf

# Documentation
*.md text eol=lf

# Configuration files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Ensure binaries are not modified
*.exe binary
*.dll binary
*.so binary
*.dylib binary
