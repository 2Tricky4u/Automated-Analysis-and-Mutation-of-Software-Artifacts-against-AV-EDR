# Worker Runtime Configuration
# Generated from automation/config.yaml
# Do not edit manually - changes will be overwritten

[worker]
worker_id = "{{WORKER_ID}}"
ip_address = "{{WORKER_IP}}"
os_version = "{{WORKER_OS_VERSION}}"
listen_port = {{WORKER_LISTEN_PORT}}

[telemetry.rededr]
base_url = "http://localhost:{{REDEDR_API_PORT}}"

[storage]
artifacts_path = "C:\\AutoMutate\\artifacts"
results_path = "C:\\AutoMutate\\results"
logs_path = "C:\\AutoMutate\\logs"

[logging]
level = "{{LOGGING_LEVEL}}"