# Controller Runtime Configuration
# Generated from automation/config.yaml
# Do not edit manually - changes will be overwritten

[server]
bind_address = "0.0.0.0:{{CONTROLLER_GRPC_PORT}}"

[elasticsearch]
url = "http://{{NETWORK_HOST_IP}}:{{CONTROLLER_ELASTICSEARCH_PORT}}"

[scheduler]
max_concurrent_runs_per_worker = {{SCHEDULER_MAX_CONCURRENT}}
run_timeout_secs = {{SCHEDULER_RUN_TIMEOUT_SECS}}
poll_interval_ms = {{SCHEDULER_POLL_INTERVAL}}
health_timeout_seconds = {{SCHEDULER_HEALTH_TIMEOUT}}


[logging]
level = "{{LOGGING_LEVEL}}"