{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ETW Telemetry Event",
  "description": "Schema for ETW telemetry events captured during analysis",
  "type": "object",
  "required": ["event_id", "timestamp", "event_type"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix timestamp in milliseconds"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[0-9]{6}$",
      "description": "Associated job identifier"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "process_create",
        "process_terminate",
        "thread_create",
        "image_load",
        "network_connect",
        "registry_set",
        "file_create",
        "file_delete"
      ],
      "description": "Type of ETW event"
    },
    "process": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "description": "Process ID"
        },
        "parent_pid": {
          "type": "integer",
          "description": "Parent process ID"
        },
        "image_name": {
          "type": "string",
          "description": "Process executable name"
        },
        "command_line": {
          "type": "string",
          "description": "Process command line"
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "source_ip": {
          "type": "string",
          "format": "ipv4"
        },
        "source_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dest_ip": {
          "type": "string",
          "format": "ipv4"
        },
        "dest_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "type": "string",
          "enum": ["TCP", "UDP", "ICMP"]
        }
      }
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Full file path"
        },
        "operation": {
          "type": "string",
          "enum": ["create", "delete", "modify", "read"]
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of the file"
        }
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Registry key path"
        },
        "value_name": {
          "type": "string",
          "description": "Registry value name"
        },
        "value_data": {
          "type": "string",
          "description": "Registry value data"
        },
        "operation": {
          "type": "string",
          "enum": ["set", "delete", "query"]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Additional event metadata"
    }
  }
}
