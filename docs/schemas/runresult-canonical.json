{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical RunResult",
  "description": "Canonical format for run results per CLAUDE.md Section 6",
  "type": "object",
  "required": ["run_id", "artifact_id", "worker_id", "start_ts", "end_ts", "status"],
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique run identifier"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 hash of the artifact"
    },
    "worker_id": {
      "type": "string",
      "pattern": "^worker-[0-9]{2}$",
      "description": "Worker VM identifier"
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "params"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Mutation identifier like ast.import_reshape"
          },
          "params": {
            "type": "object",
            "description": "Mutation-specific parameters"
          }
        }
      }
    },
    "start_ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp"
    },
    "end_ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["detected", "not_detected", "noisy", "crash"],
      "description": "Run outcome"
    },
    "labels": {
      "type": "object",
      "properties": {
        "telemetry_seen": {
          "type": "boolean"
        },
        "alert_level": {
          "type": "string",
          "enum": ["none", "low", "med", "high"]
        },
        "blocked": {
          "type": "boolean"
        },
        "detection_latency_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "perf": {
      "type": "object",
      "properties": {
        "cpu_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mem_mb": {
          "type": "integer",
          "minimum": 0
        },
        "event_to_record_ms_p95": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Free text observations"
    }
  }
}
